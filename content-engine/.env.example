# Copy to .env and fill in. Nothing here is required for the MVP.

# Database location (SQLite file by default; any SQLAlchemy URL works, e.g. Postgres later)
ENGINE_DB_URL=sqlite:///data/engine.db

# Which brand profile in config/brands/ to use by default
ENGINE_BRAND=daily-benefit-shorts

# Flask session secret for flash messages (any random string)
ENGINE_SECRET_KEY=change-me

# Optional: enables the "Claude" script generator. Leave blank to use templates only.
ANTHROPIC_API_KEY=
# Optional overrides for the Claude generator
ENGINE_CLAUDE_MODEL=claude-opus-5-5
ENGINE_CLAUDE_EFFORT=medium
